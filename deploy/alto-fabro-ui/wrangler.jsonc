{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fabro-alto-ui",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
